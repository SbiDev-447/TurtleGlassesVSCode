  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7f8570",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#8a9a5b"
      }
    },
    {
      "name": "Color",
      "scope": [
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#d4a840"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#b85a7a"
      }
    },
    {
      "name": "Storage - Type",
      "scope": [
        "storage.type"
      ],
      "settings": {
        "foreground": "#4d7a99"
      }
    },
    {
      "name": "Storage - Modifier",
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#4d7a99"
      }
    },
    {
      "name": "Control Keyword",
      "scope": [
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "foreground": "#af3a03",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operator, Misc",
      "scope": [
        "keyword.control",
        "meta.tag",
        "keyword.other.template",
        "keyword.other.substitution",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#af3a03"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#a04f3e"
      }
    },
    {
      "name": "ini File Definition",
      "scope": [
        "keyword.other.definition.ini"
      ],
      "settings": {
        "foreground": "#4d7a99"
      }
    },
    {
      "name": "Exception",
      "scope": [
        "keyword.control.trycatch"
      ],
      "settings": {
        "foreground": "#af3a03",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Identifier",
      "scope": [
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#4d7a99"
      }
    },
    {
      "name": "Punctuation, Brace",
      "scope": [
        "punctuation",
        "punctuation.definition.tag",
        "punctuation.separator.inheritance.php",
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html",
        "punctuation.section.embedded",
        "meta.brace",
        "keyword.operator.type.annotation",
        "keyword.operator.namespace"
      ],
      "settings": {
        "foreground": "#a04f3e"
      }
    },
    {
      "name": "Tag - HTML/JSX/XML",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx",
        "meta.tag.sgml"
      ],
      "settings": {
        "foreground": "#b57614"
      }
    },
    {
      "name": "Tag - Closing and punctuation",
      "scope": [
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html",
        "punctuation.definition.tag.begin.jsx",
        "punctuation.definition.tag.end.jsx",
        "punctuation.definition.tag.begin.tsx",
        "punctuation.definition.tag.end.tsx"
