      "settings": {
        "foreground": "#f3f6f9"
      }
    },
    {
      "name": "Enum Member",
      "scope": ["variable.other.enummember"],
      "settings": {
        "foreground": "#A6D9CA"
      }
    },
    {
      "name": "Other Variable",
      "scope": ["support.other.variable"],
      "settings": {
        "foreground": "#f3f6f9"
      }
    },
    {
      "name": "String Link",
      "scope": ["string.other.link"],
      "settings": {
        "foreground": "#7fb4ca"
      }
    },
    {
      "name": "Constant",
