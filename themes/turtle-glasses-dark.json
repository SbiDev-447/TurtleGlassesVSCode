  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#8394A3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": ["variable", "string constant.other.placeholder"],
      "settings": {
        "foreground": "#f3f6f9"
      }
    },
    {
      "name": "Color",
      "scope": ["constant.other.color"],
      "settings": {
        "foreground": "#ffe066"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#cb7c94"
      }
    },
    {
      "name": "Storage - Type",
      "scope": ["storage.type"],
      "settings": {
        "foreground": "#8FB8DD"
      }
    },
    {
      "name": "Storage - Modifier",
      "scope": ["storage.modifier"],
      "settings": {
        "foreground": "#cb7c94"
      }
    },
    {
      "name": "Control Keyword",
      "scope": [
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "foreground": "#C99AD6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operator, Misc",
      "scope": [
        "keyword.control",
        "constant.other.color",
        "meta.tag",
        "keyword.other.template",
        "keyword.other.substitution",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#C99AD6"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#DEBA87"
      }
    },
    {
      "name": "ini File Definition",
      "scope": ["keyword.other.definition.ini"],
      "settings": {
        "foreground": "#ffe066"
      }
    },
    {
      "name": "Exception",
      "scope": ["keyword.control.trycatch"],
      "settings": {
        "foreground": "#C99AD6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Identifier",
      "scope": ["keyword.other.unit", "keyword.other"],
      "settings": {
